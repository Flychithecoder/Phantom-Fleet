# Phantom Fleet — environment configuration
# Copy to .env and fill in real values before starting the backend.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://phantomfleet:phantomfleet_dev@localhost:5436/phantomfleet

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── IPRoyal Proxy ────────────────────────────────────────────────────────────
# MODE A — ISP static proxies (recommended for WiFi-connected phone fleet)
# After purchasing ISP proxies on IPRoyal, go to dashboard → ISP Proxies → Export
# Copy the list and paste as comma-separated values, or save to a file.
#
# Option 1: inline comma-separated (host:port:user:pass per proxy)
IPROYAL_ISP_PROXIES=1.2.3.4:12321:myuser:mypass,5.6.7.8:12321:myuser:mypass
# Option 2: file path (one host:port:user:pass per line)
# IPROYAL_ISP_FILE=C:\Users\User\Desktop\Scaler Pro\phantomfleet\proxies.txt
# Option 3: shared credentials (host:port only in list/file, creds here)
# IPROYAL_ISP_USER=myuser
# IPROYAL_ISP_PASS=mypass

# MODE B — Rotating residential (legacy / fallback)
# IPROYAL_USER=your_iproyal_username
# IPROYAL_PASS=your_iproyal_password
# IPROYAL_HOST=geo.iproyal.com
# IPROYAL_PORT_SOCKS=12321
# IPROYAL_PORT_HTTP=8080

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
PHANTOM_DAILY_LLM_CAP_USD=25.0

# ── Z.ai (GLM) — alternative model backend ──────────────────────────────────
# Enable to route some roles to z.ai GLM models instead of Anthropic.
# API key from https://z.ai (bigmodel.cn for China region).
PF_ZAI_API_KEY=
# OpenAI-compatible base URL (international endpoint; the CN endpoint is
# https://open.bigmodel.cn/api/paas/v4/).
PF_ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
# Per-role model aliases. The model_router picks these when the role's
# backend is set to "zai". Leave blank to disable that role on z.ai.
# Suggested defaults (research 2026-11-25):
#   PLAN: glm-5.3        ($1.40/$4.40 per 1M, 1M ctx, Sonnet-4.6-class claimed)
#   WORK: glm-4.6        ($0.60/$2.20 per 1M, 200K ctx) or glm-5.3-flashx ($0.37/$1.25, 1M)
#   FAST: glm-4.5-air    ($0.20/$1.10 per 1M)  — or free glm-4.5-flash for dev
# No GLM model matches Opus 4.7 reasoning; keep COO on Claude unless cost forces otherwise.
PF_ZAI_MODEL_PLAN=
PF_ZAI_MODEL_WORK=
PF_ZAI_MODEL_FAST=
# Hard caps so a misroute cannot burn the budget.
PF_ZAI_DAILY_CAP_USD=10.0
PF_ZAI_MAX_TOKENS_PER_CALL=16000

# ── Z.ai CLI agent ──────────────────────────────────────────────────────────
# Z.ai ships ZCode (their Claude-Code-equivalent) and also supports running
# Claude Code itself against their Anthropic-shape endpoint:
#   ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
#   ANTHROPIC_AUTH_TOKEN=<GLM Coding Plan key>
# That is the fastest path to use the GLM Coding Plan subscription (Lite
# $18/mo, Pro, Max) under the existing claude CLI — no separate binary needed.
# If using ZCode natively instead, point PF_ZAI_CLI_BIN at its binary.
PF_ZAI_CLI_BIN=
# "api_key" uses PF_ZAI_API_KEY (pay-as-you-go);
# "plan" uses the CLI's signed-in GLM Coding Plan session.
PF_ZAI_CLI_AUTH_MODE=api_key
# Anthropic-shape endpoint the plan is scoped to. Setting this ALSO lets a
# standard `claude` CLI run against z.ai when ANTHROPIC_AUTH_TOKEN is the
# plan key — see runner/src/zai.mjs for the route.
PF_ZAI_ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# ── Model router ────────────────────────────────────────────────────────────
# Per-role backend selector. Values: "anthropic" | "zai" | "auto".
# "auto" lets core.model_router pick based on cost/quality signals from
# Causal Fleet Memory (recall-similarity-weighted outcome scoring).
PF_ROUTER_ROLE_COO=anthropic
PF_ROUTER_ROLE_WORKER=anthropic
PF_ROUTER_ROLE_FAST=anthropic

# ── Session encryption ───────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PHANTOM_SESSION_KEY=replace_with_64_char_hex_string

# ── Server ───────────────────────────────────────────────────────────────────
PHANTOM_HOST=0.0.0.0
PHANTOM_PORT=8000
PHANTOM_RELOAD=true
PHANTOM_ALLOWED_ORIGINS=http://localhost:3016

# ── ADB ──────────────────────────────────────────────────────────────────────
ADB_PATH=C:\Onimator\full_igbot_14.1.8.1\adb.exe
