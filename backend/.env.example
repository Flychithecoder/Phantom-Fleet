# Phantom Fleet — environment configuration
# Copy to .env and fill in real values before starting the backend.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://phantomfleet:phantomfleet_dev@localhost:5436/phantomfleet

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── IPRoyal Proxy ────────────────────────────────────────────────────────────
# MODE A — ISP static proxies (recommended for WiFi-connected phone fleet)
# After purchasing ISP proxies on IPRoyal, go to dashboard → ISP Proxies → Export
# Copy the list and paste as comma-separated values, or save to a file.
#
# Option 1: inline comma-separated (host:port:user:pass per proxy)
IPROYAL_ISP_PROXIES=1.2.3.4:12321:myuser:mypass,5.6.7.8:12321:myuser:mypass
# Option 2: file path (one host:port:user:pass per line)
# IPROYAL_ISP_FILE=C:\Users\User\Desktop\Scaler Pro\phantomfleet\proxies.txt
# Option 3: shared credentials (host:port only in list/file, creds here)
# IPROYAL_ISP_USER=myuser
# IPROYAL_ISP_PASS=mypass

# MODE B — Rotating residential (legacy / fallback)
# IPROYAL_USER=your_iproyal_username
# IPROYAL_PASS=your_iproyal_password
# IPROYAL_HOST=geo.iproyal.com
# IPROYAL_PORT_SOCKS=12321
# IPROYAL_PORT_HTTP=8080

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
PHANTOM_DAILY_LLM_CAP_USD=25.0

# ── Session encryption ───────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PHANTOM_SESSION_KEY=replace_with_64_char_hex_string

# ── Server ───────────────────────────────────────────────────────────────────
PHANTOM_HOST=0.0.0.0
PHANTOM_PORT=8000
PHANTOM_RELOAD=true
PHANTOM_ALLOWED_ORIGINS=http://localhost:3016

# ── ADB ──────────────────────────────────────────────────────────────────────
ADB_PATH=C:\Onimator\full_igbot_14.1.8.1\adb.exe
